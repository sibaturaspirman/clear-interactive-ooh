CLEAR_API_URL=https://clear-api.srv1.antigravity.dev
LED_KEY=
FAL_KEY=
# WAVESPEED_API_KEY=   # required if any step uses WaveSpeed (face-swap always does)
# PORTRAIT_PROVIDER=fal   # default for steps without their own *_PROVIDER
# PORTRAIT_EDIT_PROVIDER=fal       # fal | wavespeed — step 1 (nano / seedream)
# PORTRAIT_FACE_SWAP_PROVIDER=wavespeed   # only wavespeed supported
# PORTRAIT_REMOVE_BG_PROVIDER=fal  # fal | wavespeed — step 3
# PORTRAIT_EDIT_MODEL=nano-banana   # nano-banana (default) | seedream-v5-pro
# Face-swap step on/off — PORTRAIT_FACE_SWAP or FAL_PORTRAIT_FACE_SWAP (true/false)
# FAL_PORTRAIT_FACE_SWAP=true
NEXT_PUBLIC_APP_URL=https://www.clearxorbr.id
# Optional: override default placeholder nohp (default 000000000 → 628000000000 after format)
# MICROSITE_PLACEHOLDER_NOHP=081234567890
# Log { urlPreview, location_id, nohp } to server console on each submit (debug 422 vs ?test)
# MICROSITE_DEBUG_SUBMIT=1

# LED / Broadsign microsite QR: `dynamic` = /api/microsite/led-qr (signed ?w=) + session gate. `static` = PNG in public/images/led/*-qr.png (no ?w= gate)
# NEXT_PUBLIC_MICROSITE_LED_QR_MODE=dynamic
# MICROSITE_LED_QR_MODE=dynamic
# Secret for signed microsite session (?w= + httpOnly submit cookie). Min 16 chars. Required in production.
# MICROSITE_SESSION_SECRET=
# Skip ?w= exchange for local QA (never enable in production)
# MICROSITE_SESSION_BYPASS=true
# Bump when replacing `public/images/**` files (same filename) — or edit `LED_STATIC_ASSET_VERSION` in code
# NEXT_PUBLIC_LED_ASSET_VERSION=3
# Allow microsite ?test bypass (skip fal) on non-dev deploys
# MICROSITE_TEST_BYPASS=true
# Allow ?foto debug pipeline on non-dev deploys (runs paid AI)
# MICROSITE_FOTO_DEBUG=true
